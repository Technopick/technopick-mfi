{
  "components": {
    "schemas": {
      "ApplyRequest": {
        "properties": {
          "amount": {
            "minLength": 1,
            "pattern": "^\\d{1,15}(\\.\\d{1,2})?$",
            "type": "string"
          },
          "billRef": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "currency": {
            "minLength": 1,
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "msisdnMasked": {
            "type": "string"
          },
          "shortCode": {
            "minLength": 1,
            "type": "string"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          },
          "transId": {
            "minLength": 1,
            "pattern": "^[A-Z0-9]{8,20}$",
            "type": "string"
          },
          "transTime": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency",
          "shortCode",
          "tenantId",
          "transId",
          "transTime"
        ],
        "type": "object"
      },
      "ApplyResponse": {
        "properties": {
          "accountNumber": {
            "type": "string"
          },
          "journalEntryId": {
            "format": "uuid",
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "paymentId": {
            "format": "uuid",
            "type": "string"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "AuthorizeRequest": {
        "properties": {
          "accountNumber": {
            "minLength": 1,
            "type": "string"
          },
          "acquirerId": {
            "minLength": 1,
            "type": "string"
          },
          "amount": {
            "minLength": 1,
            "pattern": "^\\d{1,15}(\\.\\d{1,4})?$",
            "type": "string"
          },
          "channel": {
            "minLength": 1,
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "currency": {
            "minLength": 1,
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "fee": {
            "pattern": "^\\d{1,15}(\\.\\d{1,4})?$",
            "type": "string"
          },
          "rrn": {
            "type": "string"
          },
          "stan": {
            "minLength": 1,
            "type": "string"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          },
          "terminalId": {
            "type": "string"
          },
          "transmissionDateTime": {
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "enum": [
              "BALANCE_ENQUIRY",
              "MINI_STATEMENT",
              "CASH_WITHDRAWAL",
              "CASH_DEPOSIT",
              "PURCHASE",
              "FUNDS_TRANSFER",
              "BILL_PAYMENT",
              "PRE_AUTHORIZATION",
              "PRE_AUTHORIZATION_COMPLETION",
              "REFUND",
              "LOAN_REPAYMENT",
              "LOAN_DISBURSEMENT"
            ],
            "type": "string"
          }
        },
        "required": [
          "accountNumber",
          "acquirerId",
          "amount",
          "channel",
          "currency",
          "stan",
          "tenantId",
          "transmissionDateTime",
          "type"
        ],
        "type": "object"
      },
      "AuthorizeResponse": {
        "properties": {
          "approved": {
            "type": "boolean"
          },
          "availableBalance": {
            "type": "string"
          },
          "holdAmount": {
            "type": "string"
          },
          "holdId": {
            "format": "uuid",
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "BalanceResponse": {
        "properties": {
          "accountNumber": {
            "type": "string"
          },
          "activeHolds": {
            "type": "string"
          },
          "availableBalance": {
            "type": "string"
          },
          "ledgerBalance": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CompleteRequest": {
        "properties": {
          "amount": {
            "minLength": 1,
            "pattern": "^\\d{1,15}(\\.\\d{1,4})?$",
            "type": "string"
          },
          "channel": {
            "minLength": 1,
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "currency": {
            "minLength": 1,
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "fee": {
            "pattern": "^\\d{1,15}(\\.\\d{1,4})?$",
            "type": "string"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "channel",
          "currency",
          "tenantId"
        ],
        "type": "object"
      },
      "CompleteResponse": {
        "properties": {
          "entryId": {
            "format": "uuid",
            "type": "string"
          },
          "holdId": {
            "format": "uuid",
            "type": "string"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "Decision": {
        "properties": {
          "journalEntryId": {
            "format": "uuid",
            "type": "string"
          },
          "resolutionId": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "OpenItem": {
        "properties": {
          "ageDays": {
            "format": "int32",
            "type": "integer"
          },
          "amount": {
            "type": "string"
          },
          "billRef": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "msisdnMasked": {
            "type": "string"
          },
          "paymentId": {
            "format": "uuid",
            "type": "string"
          },
          "pendingResolutionId": {
            "format": "uuid",
            "type": "string"
          },
          "providerRef": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ResolutionCreated": {
        "properties": {
          "resolutionId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ResolutionRequest": {
        "properties": {
          "reason": {
            "maxLength": 300,
            "minLength": 0,
            "type": "string"
          },
          "targetReference": {
            "maxLength": 40,
            "minLength": 0,
            "type": "string"
          },
          "targetType": {
            "enum": [
              "DEPOSIT_ACCOUNT",
              "LOAN"
            ],
            "type": "string"
          }
        },
        "required": [
          "reason",
          "targetReference",
          "targetType"
        ],
        "type": "object"
      },
      "ReverseRequest": {
        "properties": {
          "correlationId": {
            "type": "string"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "tenantId"
        ],
        "type": "object"
      },
      "ReverseResponse": {
        "properties": {
          "holdId": {
            "format": "uuid",
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "replayed": {
            "type": "boolean"
          },
          "reversalEntryId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ValidateRequest": {
        "properties": {
          "amount": {
            "minLength": 1,
            "pattern": "^\\d{1,15}(\\.\\d{1,2})?$",
            "type": "string"
          },
          "billRef": {
            "type": "string"
          },
          "currency": {
            "minLength": 1,
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "shortCode": {
            "minLength": 1,
            "type": "string"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency",
          "shortCode",
          "tenantId"
        ],
        "type": "object"
      },
      "ValidateResponse": {
        "properties": {
          "resultCode": {
            "type": "string"
          },
          "resultDesc": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Core banking and switch authorization API. Money values are decimal strings. Errors are RFC 9457 problem details.",
    "title": "Technopick Core Banking API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/accounts/{accountNumber}/balance": {
      "get": {
        "operationId": "balance",
        "parameters": [
          {
            "in": "path",
            "name": "accountNumber",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "account-controller"
        ]
      }
    },
    "/api/v1/authorizations": {
      "post": {
        "operationId": "authorize",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
