{
  "realm": "technopick",
  "displayName": "TEST ONLY - Technopick e2e realm (test credentials, never import elsewhere)",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 600,
  "roles": {
    "realm": [
      {
        "name": "LOAN_OFFICER"
      },
      {
        "name": "BRANCH_MANAGER"
      },
      {
        "name": "SUPERVISOR"
      },
      {
        "name": "OPERATIONS"
      },
      {
        "name": "TELLER"
      },
      {
        "name": "FINANCE"
      },
      {
        "name": "INTEGRATION"
      }
    ]
  },
  "clients": [
    {
      "clientId": "staff-web",
      "name": "Technopick staff web (TEST)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:8088/*"
      ],
      "webOrigins": [
        "http://localhost:8088"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8088/*"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "0e2e0000-0000-0000-0000-000000000001",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mfi-integration",
      "name": "Integration runtime (TEST)",
      "publicClient": false,
      "secret": "e2e-only-integration-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
